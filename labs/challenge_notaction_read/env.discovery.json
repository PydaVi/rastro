{
  "target": "challenge_notaction_read",
  "bundle": "aws-iam-heavy",
  "caller_identity": {
    "Account": "123456789012",
    "Arn": "arn:aws:iam::123456789012:user/notaction-user"
  },
  "services_scanned": [
    "iam",
    "secretsmanager",
    "ec2",
    "lambda"
  ],
  "regions_scanned": [
    "us-east-1"
  ],
  "resources": [
    {
      "resource_type": "identity.user",
      "identifier": "arn:aws:iam::123456789012:user/notaction-user",
      "metadata": {
        "policy_permissions": [
          {
            "source": "i",
            "statements": [
              {
                "Effect": "Allow",
                "NotAction": [
                  "s3:GetObject"
                ],
                "Resource": "*"
              }
            ]
          }
        ]
      }
    },
    {
      "resource_type": "secret.secrets_manager",
      "identifier": "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/na-creds",
      "metadata": {
        "name": "prod/na-creds"
      }
    }
  ],
  "summary": {
    "resource_count": 2
  }
}