{
  "target": "challenge_scp_denied",
  "bundle": "aws-iam-heavy",
  "caller_identity": {
    "Account": "123456789012",
    "Arn": "arn:aws:iam::123456789012:user/scp-user"
  },
  "services_scanned": [
    "iam",
    "secretsmanager",
    "ec2",
    "lambda"
  ],
  "regions_scanned": [
    "us-east-1"
  ],
  "resources": [
    {
      "resource_type": "identity.user",
      "identifier": "arn:aws:iam::123456789012:user/scp-user",
      "metadata": {
        "policy_permissions": [
          {
            "source": "i",
            "statements": [
              {
                "Effect": "Allow",
                "Action": [
                  "sts:AssumeRole"
                ],
                "Resource": [
                  "arn:aws:iam::123456789012:role/scp-blocked-admin"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "resource_type": "identity.role",
      "identifier": "arn:aws:iam::123456789012:role/scp-blocked-admin",
      "metadata": {
        "trust_principals": [
          "arn:aws:iam::123456789012:user/scp-user"
        ],
        "policy_permissions": [],
        "assumable_by": [
          "arn:aws:iam::123456789012:user/scp-user"
        ]
      }
    }
  ],
  "summary": {
    "resource_count": 2
  },
  "governance": {
    "scp_visibility": "directly_attached_only",
    "scp_policies": [
      {
        "statements": [
          {
            "Effect": "Deny",
            "Action": [
              "sts:AssumeRole"
            ],
            "Resource": "*"
          }
        ]
      }
    ]
  }
}