{
  "target": "heldout_ec2_startsession",
  "bundle": "aws-iam-heavy",
  "caller_identity": {
    "Account": "123456789012",
    "Arn": "arn:aws:iam::123456789012:user/ho-ops"
  },
  "services_scanned": [
    "iam",
    "secretsmanager",
    "ec2",
    "lambda"
  ],
  "regions_scanned": [
    "us-east-1"
  ],
  "resources": [
    {
      "resource_type": "identity.user",
      "identifier": "arn:aws:iam::123456789012:user/ho-ops",
      "metadata": {
        "policy_permissions": [
          {
            "source": "i",
            "statements": [
              {
                "Effect": "Allow",
                "Action": [
                  "ssm:StartSession"
                ],
                "Resource": [
                  "arn:aws:ec2:us-east-1:123456789012:instance/i-9zzz"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "resource_type": "identity.role",
      "identifier": "arn:aws:iam::123456789012:role/ho-role",
      "metadata": {
        "compute_pivot_by": [
          "arn:aws:iam::123456789012:user/ho-ops"
        ],
        "compute_pivot_profile": "arn:aws:iam::123456789012:instance-profile/ho-profile"
      }
    },
    {
      "resource_type": "compute.instance_profile",
      "identifier": "arn:aws:iam::123456789012:instance-profile/ho-profile",
      "metadata": {
        "role": "arn:aws:iam::123456789012:role/ho-role"
      }
    },
    {
      "resource_type": "compute.ec2_instance",
      "identifier": "arn:aws:ec2:us-east-1:123456789012:instance/i-9zzz",
      "metadata": {
        "instance_profile": "arn:aws:iam::123456789012:instance-profile/ho-profile"
      }
    }
  ],
  "summary": {
    "resource_count": 4
  }
}