{
  "target": "challenge_role_then_read",
  "bundle": "aws-iam-heavy",
  "caller_identity": {
    "Account": "123456789012",
    "Arn": "arn:aws:iam::123456789012:user/rtr-entry"
  },
  "services_scanned": [
    "iam",
    "secretsmanager",
    "ec2",
    "lambda"
  ],
  "regions_scanned": [
    "us-east-1"
  ],
  "resources": [
    {
      "resource_type": "identity.user",
      "identifier": "arn:aws:iam::123456789012:user/rtr-entry",
      "metadata": {
        "policy_permissions": [
          {
            "source": "i",
            "statements": [
              {
                "Effect": "Allow",
                "Action": [
                  "sts:AssumeRole"
                ],
                "Resource": [
                  "arn:aws:iam::123456789012:role/rtr-role"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "resource_type": "identity.role",
      "identifier": "arn:aws:iam::123456789012:role/rtr-role",
      "metadata": {
        "trust_principals": [
          "arn:aws:iam::123456789012:user/rtr-entry"
        ],
        "policy_permissions": [
          {
            "source": "i",
            "statements": [
              {
                "Effect": "Allow",
                "Action": [
                  "secretsmanager:GetSecretValue"
                ],
                "Resource": [
                  "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/db-creds"
                ]
              }
            ]
          }
        ],
        "assumable_by": [
          "arn:aws:iam::123456789012:user/rtr-entry"
        ]
      }
    },
    {
      "resource_type": "secret.secrets_manager",
      "identifier": "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/db-creds",
      "metadata": {
        "name": "prod/db-creds",
        "readable_by": [
          "arn:aws:iam::123456789012:role/rtr-role"
        ]
      }
    }
  ],
  "summary": {
    "resource_count": 3
  }
}