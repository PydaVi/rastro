{
  "target": "pos_lambda_env_pivot",
  "bundle": "aws-iam-heavy",
  "caller_identity": {
    "Account": "123456789012",
    "Arn": "arn:aws:iam::123456789012:user/dev"
  },
  "services_scanned": [
    "iam",
    "secretsmanager",
    "ec2",
    "lambda"
  ],
  "regions_scanned": [
    "us-east-1"
  ],
  "resources": [
    {
      "resource_type": "identity.user",
      "identifier": "arn:aws:iam::123456789012:user/dev",
      "metadata": {
        "policy_permissions": [
          {
            "source": "i",
            "statements": [
              {
                "Effect": "Allow",
                "Action": [
                  "lambda:GetFunctionConfiguration"
                ],
                "Resource": [
                  "arn:aws:lambda:us-east-1:123456789012:function:worker"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "resource_type": "identity.role",
      "identifier": "arn:aws:iam::123456789012:role/exec-role",
      "metadata": {}
    },
    {
      "resource_type": "compute.lambda_function",
      "identifier": "arn:aws:lambda:us-east-1:123456789012:function:worker",
      "metadata": {
        "name": "worker",
        "execution_role": "arn:aws:iam::123456789012:role/exec-role",
        "readable_by": [
          "arn:aws:iam::123456789012:user/dev"
        ]
      }
    }
  ],
  "summary": {
    "resource_count": 3
  }
}